{
  "manifest_version": 3,
  "name": "SmartOps Tab Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Shares safe structure from one explicitly selected tab with the local SmartOps core.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Share this tab with SmartOps"
  }
}
